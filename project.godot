; Mahjong Christmas (GodotMahjongClaudeChristmas)
config_version=5

[application]

config/name="Mahjong Christmas"
config/icon="res://icon.svg"
run/main_scene="res://scenes/MainMenu.tscn"

[autoload]

SaveData="*res://autoload/SaveData.gd"
ThemeData="*res://autoload/ThemeData.gd"
LevelData="*res://autoload/LevelData.gd"
Economy="*res://autoload/Economy.gd"
Nav="*res://autoload/Nav.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.031, 0.075, 0.094, 1)
textures/vram_compression/import_etc2_astc=true

[input]

ui_accept={"deadzone": 0.5, "events": [Object(InputEventKey,"physical_keycode":4194309)]}

[input_devices]

pointing/emulate_mouse_from_touch=false
